    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "nest-winston": "^1.10.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.13.5",
    "@teo-garcia/eslint-config-shared": "^0.4.2",
    "@teo-garcia/prettier-config-shared": "^0.2.10",
    "@teo-garcia/tsconfig-shared": "^0.2.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prisma": "7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "license": "MIT",
  "name": "nest-template-monolith",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "check": "pnpm lint:es:check && pnpm lint:ts && pnpm format:check && pnpm test",
    "commitlint": "commitlint --edit",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --project tsconfig.seed.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:es": "eslint . --fix",
    "lint:es:check": "eslint .",
    "lint:staged": "lint-staged",
    "lint:ts": "tsc --noEmit",
    "prepare": "husky",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --runInBand",
    "test:e2e": "DOTENV_CONFIG_PATH=.env.test vitest run --config ./vitest.e2e.config.ts",
    "test:watch": "vitest"
  },
  "version": "0.0.0"
}
